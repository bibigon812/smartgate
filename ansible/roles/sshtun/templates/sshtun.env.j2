# Managed by Ansible (sshtun role): {{ inventory_hostname }}, tunnel {{ t.name }}.
SSHTUN_NAME="{{ t.name }}"
SSHTUN_TUN="{{ t.tun }}"
SSHTUN_EXIT_HOST="{{ t.exit_host }}"
SSHTUN_EXIT_PORT="{{ t.exit_port }}"
SSHTUN_SSH_USER="{{ t.ssh_user }}"
SSHTUN_SSH_KEY="{{ t.ssh_key }}"
SSHTUN_KNOWN_HOSTS="{{ t.known_hosts if (t.seed_known_hosts | bool) else '' }}"
SSHTUN_LOCAL_ADDR="{{ t.local_addr }}"
SSHTUN_REMOTE_ADDR="{{ t.remote_addr }}"
SSHTUN_MANAGE_REMOTE="{{ '1' if (t.manage_remote | bool) else '0' }}"
SSHTUN_MTU="{{ t.mtu }}"
SSHTUN_DEV_WAIT="{{ t.dev_wait }}"
SSHTUN_CHECK_INTERVAL="{{ t.check_interval }}"
SSHTUN_DOWN_THRESHOLD="{{ t.check_down_threshold }}"
SSHTUN_BACKOFF_BASE="{{ t.backoff_base }}"
SSHTUN_BACKOFF_MAX="{{ t.backoff_max }}"

{%- set dev = 'tun' ~ t.tun -%}
{%- set peer = t.local_addr | regex_replace('/.*', '') -%}
{%- set opts = t.ssh_options | map('regex_replace', '^', '-o ') | join(' ') ~ ' -o IdentitiesOnly=yes' -%}
{%- set opts = opts ~ ((' -o UserKnownHostsFile=' ~ t.known_hosts) if (t.seed_known_hosts | bool) else '') %}

SSHTUN_SSH_OPTIONS="{{ opts }}"

{% if (t.manage_remote | bool) %}
SSHTUN_REMOTE_CMD="ip addr replace {{ t.remote_addr }} peer {{ peer }} dev {{ dev }} && ip link set dev {{ dev }} mtu {{ t.mtu }} up && exec sleep 2147483647"
{% else %}
SSHTUN_REMOTE_CMD="exec sleep 2147483647"
{% endif %}
