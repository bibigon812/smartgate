zebra=yes
bgpd=yes
ospfd=no
bgp_gossip=no
watchfrr=yes
staticd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no
pbrd=no
elstd=no
snmp=no

# На домашнем шлюзе gRPC пока можно не включать, управляем через CLI/vtysh
grpcd=no

# Настройки буферов netlink (дома тоже выделим запас, так как влетит 48к+ маршрутов)
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
